# Velo API Configuration
# Dapatkan API key dari https://velo.xyz
VELO_API_KEY=your_api_key_here

# Exchange API Configuration (OKX, Tokocrypto, Binance)
EXCHANGE_API_KEY=your_exchange_api_key_here
EXCHANGE_SECRET_KEY=your_exchange_secret_key_here
EXCHANGE_PASSPHRASE=your_exchange_passphrase_here

# Database Configuration
TIMESCALE_SERVICE_URL=your_timescale_url_here

PGPASSWORD=your_db_password_here
PGUSER=your_db_user_here
PGDATABASE=your_db_name_here
PGHOST=your_db_host_here
PGPORT=5432
PGSSLMODE=require

# Redis Configuration
REDIS_PROVIDER=local
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_USERNAME=
REDIS_SSL=false
REDIS_DEFAULT_TTL=60

# Telegram Bot Configuration
# Dapatkan bot token dari https://t.me/BotFather
TELEGRAM_BOT_ENABLED=false
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Telegram Group Chat IDs
# Dapatkan chat ID dari @userinfobot atau https://api.telegram.org/bot<token>/getUpdates
TELEGRAM_GROUP_FREE_BTC_ETH=your_free_btc_eth_group_id_here
TELEGRAM_GROUP_FREE_ALL_CRYPTO=your_free_all_crypto_group_id_here
TELEGRAM_GROUP_PRO_CRYPTO_FOREX=your_pro_crypto_forex_group_id_here
TELEGRAM_GROUP_PRO_INDO_IDX=your_pro_indo_idx_group_id_here
TELEGRAM_GROUP_ENTERPRISE=your_enterprise_group_id_here